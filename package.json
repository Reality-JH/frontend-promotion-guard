{
  "name": "frontend-promotion-guard",
  "version": "0.4.0",
  "description": "Release gate for CSS integrity, computed styles, visual regression, and candidate-gated Docker promotion.",
  "keywords": [
    "visual-regression",
    "release-gate",
    "screenshot-testing",
    "computed-style",
    "css-audit",
    "deployment-verification",
    "docker-promotion",
    "rollback",
    "pixelmatch",
    "playwright-core",
    "ci-cd",
    "docker",
    "playwright",
    "frontend"
  ],
  "homepage": "https://github.com/Reality-JH/frontend-promotion-guard#readme",
  "bugs": "https://github.com/Reality-JH/frontend-promotion-guard/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Reality-JH/frontend-promotion-guard.git"
  },
  "type": "module",
  "bin": {
    "fpg": "dist/cli.js"
  },
  "files": [
    "dist",
    "action.yml",
    "fpg.example.yml",
    "LICENSE",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-concurrency=1 test/action.test.mjs test/audit.test.mjs test/cli.test.mjs test/config.test.mjs test/github.test.mjs test/monitor.test.mjs test/report.test.mjs test/storage.test.mjs test/visual.test.mjs",
    "test:docker": "node scripts/docker-integration.mjs",
    "license:check": "node scripts/check-licenses.mjs",
    "example:build": "vite build --config examples/vite-react/vite.config.ts",
    "example:serve": "vite preview --config examples/vite-react/vite.config.ts --host 127.0.0.1 --port 4173",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "pixelmatch": "7.1.0",
    "playwright-core": "1.55.0",
    "pngjs": "7.0.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/pngjs": "6.0.5",
    "@vitejs/plugin-react": "5.2.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "typescript": "5.9.2",
    "vite": "7.3.6"
  }
}
